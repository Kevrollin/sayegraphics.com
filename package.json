{
  "name": "saye-graphics-site",
  "private": true,
  "version": "1.0.0",
  "description": "Website for Saye Graphics Ltd, a branding, signage and printing business in Nakuru, Kenya.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs",
    "media": "node scripts/optimize-media.mjs",
    "logo": "node scripts/logo-to-svg.mjs",
    "videos": "node scripts/video/transcode-videos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
